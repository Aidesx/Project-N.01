@model IEnumerable<OrderModels>
@{
    ViewBag.Title = "Đơn hàng";
}
<h3>Danh sách đơn hàng</h3>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">User Email</th>
            <th scope="col">Order Number</th>
            <th scope="col">Order Date</th>
            <th scope="col">Order Total</th>
            <th scope="col">Order Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.UserName</td>
                <td>@item.OrderNumber</td>
                <td>@item.OrderDate</td>
                <td>@item.Total</td>
                <td>@item.Status</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="text text-success">Đơn hàng đang xử lý</span>
                    }
                    else
                    {
                        <span class="text text-danger">Đơn hàng đã xử lý</span>
                    }

                </td>

                <td>
                    <a asp-action="ViewOrder" asp-route-orderNumber="@item.OrderNumber" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm confirmDeletion">Xóa</a>
            </tr>
        }

    </tbody>
</table>
