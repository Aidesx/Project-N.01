@model IEnumerable<OrderModels>
@{
    ViewData["Title"] = "Danh sách đơn hàng";
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}

<div class="admin-card">
    <h4 style="margin-bottom: 1.5rem;">
        <i class="fa fa-shopping-cart"></i> @ViewData["Title"]
    </h4>

    <div class="table-responsive">
        <table class="table" id="my_table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Email khách hàng</th>
                    <th>Mã đơn hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.UserName</td>
                        <td>@item.OrderNumber</td>
                        <td>@item.OrderDate</td>
                        <td>@item.Total.ToString("#,##0 VND")</td>
                        <td>
                            @if (item.Status == 1)
                            {
                                <span class="badge" style="background: #065f46; color: #a7f3d0;">Đang xử lý</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #7f1d1d; color: #fecaca;">Đã xử lý</span>
                            }
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <a asp-action="ViewOrder" asp-route-orderNumber="@item.OrderNumber" class="btn-admin-primary btn-sm" style="padding:0.25rem 0.75rem; font-size:15px;">
                                    <i class="fa fa-eye"></i> Chi tiết
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm confirmDeletion" 
                                            style="background:#7f1d1d; color:#fecaca; border:1px solid #b91c1c; padding:0.25rem 0.75rem; font-size:15px;">
                                        <i class="fa fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (pager != null && pager.TotalPage > 1)
    {
        <ul class="pagination justify-content-end" style="margin-top: 1rem;">
            @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="1">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                </li>
            }
            @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }
            @if (pager.CurrentPage < pager.TotalPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.confirmDeletion').click(function (e) {
                e.preventDefault();
                var form = $(this).closest('form');
                Swal.fire({
                    title: 'Bạn chắc chắn?',
                    text: 'Đơn hàng sẽ bị xóa vĩnh viễn!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Xóa',
                    background: '#0d1117',
                    color: '#e2e8f0',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}