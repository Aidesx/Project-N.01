@model IEnumerable<OrderModels>
@{
    ViewBag.Title = "Đơn hàng";
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}
<h3>Danh sách đơn hàng</h3>
<table class="table" id="my_table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">User Email</th>
            <th scope="col">Order Number</th>
            <th scope="col">Order Date</th>
            <th scope="col">Order Total</th>
            <th scope="col">Order Status</th>
            <th scope="col">Status Description</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.UserName</td>
                <td>@item.OrderNumber</td>
                <td>@item.OrderDate</td>
                <td>@item.Total.ToString("#,##0 VND")</td>
                <td>@item.Status</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="text text-success">Đơn hàng đang xử lý</span>
                    }
                    else
                    {
                        <span class="text text-danger">Đơn hàng đã xử lý</span>
                    }

                </td>

                <td>
                    <a asp-action="ViewOrder" asp-route-orderNumber="@item.OrderNumber" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm confirmDeletion">Xóa</a>
                </td>
            </tr>
        }

    </tbody>
</table>

@if (pager != null && pager.TotalPage > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-end">
            @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="1">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                </li>
            }

            @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }

            @if (pager.CurrentPage < pager.TotalPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                </li>
            }
        </ul>
    </nav>
}
