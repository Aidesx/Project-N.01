@model IEnumerable<OrderModels>
@{
    ViewData["Title"] = "Danh sách đơn hàng";
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}

<div class="admin-card">
    <h4 style="margin-bottom: 1.5rem;">
        <i class="fa fa-shopping-cart"></i> @ViewData["Title"]
    </h4>

    <div class="table-responsive">
        <table class="table" id="my_table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Mã đơn hàng</th>
                    <th>Ngày đặt</th>
                    <th>Khách hàng</th>
                    <th>Người nhận & SĐT</th>
                    <th>Thanh toán</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>#@item.OrderNumber</strong></td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.UserName</td>
                        <td>@(string.IsNullOrEmpty(item.ReceiverName) ? item.UserName : item.ReceiverName) <br /><small style="color:#94a3b8;">@item.PhoneNumber</small></td>
                        <td>
                            <span class="app-badge @(item.PaymentMethod == "MoMo" ? "app-badge--momo" : "app-badge--cod")">
                                @(item.PaymentMethod == "MoMo" ? "Ví MoMo" : "COD")
                            </span>
                        </td>
                        <td><strong>@item.Total.ToString("#,##0 VND")</strong></td>
                        <td>
                            @switch (item.Status)
                            {
                                case 1:
                                    <span class="app-badge app-badge--paid">Đã thanh toán (MoMo)</span>
                                    break;
                                case 2:
                                    <span class="app-badge app-badge--processing">Đang đóng gói</span>
                                    break;
                                case 3:
                                    <span class="app-badge app-badge--shipping">Đang giao hàng</span>
                                    break;
                                case 4:
                                    <span class="app-badge app-badge--completed">Hoàn thành</span>
                                    break;
                                case 5:
                                    <span class="app-badge app-badge--cancelled">Đã hủy</span>
                                    break;
                                default:
                                    <span class="app-badge app-badge--pending">Chờ xử lý (COD)</span>
                                    break;
                            }
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <a asp-action="ViewOrder" asp-route-orderNumber="@item.OrderNumber" class="btn-app btn-app-sm btn-app-primary">
                                    <i class="fa fa-eye"></i> Chi tiết
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline; margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-app btn-app-sm btn-app-danger confirmDeletion">
                                        <i class="fa fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (pager != null && pager.TotalPage > 1)
    {
        <ul class="pagination justify-content-end" style="margin-top: 1rem;">
            @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="1">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                </li>
            }
            @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }
            @if (pager.CurrentPage < pager.TotalPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Order" asp-action="Index" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.confirmDeletion').click(function (e) {
                e.preventDefault();
                var form = $(this).closest('form');
                Swal.fire({
                    title: 'Bạn chắc chắn?',
                    text: 'Đơn hàng sẽ bị xóa vĩnh viễn!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Xóa',
                    background: '#0d1117',
                    color: '#e2e8f0',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}