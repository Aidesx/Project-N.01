@model IEnumerable<Project_385.Models.ViewModels.UserWithRoleViewModel>
@{
    ViewData["title"] = "Danh sách User";
}
<h3>Danh sách User</h3>
<a asp-action="Create" class="btn btn-primary mb-3">Tạo User mới</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.UserName</td>
                <td>@item.Email</td>
                <td>
                    @if (item.Role == "Admin")
                    {
                        <span class="text text-danger">@item.Role</span>
                    }
                    else
                    {
                        <span class="text text-success">@item.Role</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Chỉnh sửa</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm confirmDeletion">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>