@model Project_385.Models.UserModels
@{
    ViewData["Title"] = "Tạo User mới";
}

<div class="admin-card" style="max-width: 800px; margin: 0 auto;">
    <h4 style="margin-bottom: 1.5rem;">
        <i class="fa fa-user-plus"></i> @ViewData["Title"]
    </h4>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;"></div>

        <div class="form-group">
            <label style="color: #cbd5e1; font-weight: 500;">Username</label>
            <input asp-for="UserName" class="form-control" style="background: #111827; border: 1px solid #1e3a5f; color: #f0f4ff;" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label style="color: #cbd5e1; font-weight: 500;">Email</label>
            <input asp-for="Email" class="form-control" style="background: #111827; border: 1px solid #1e3a5f; color: #f0f4ff;" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label style="color: #cbd5e1; font-weight: 500;">Password</label>
            <input asp-for="Password" class="form-control" type="password" style="background: #111827; border: 1px solid #1e3a5f; color: #f0f4ff;" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label style="color: #cbd5e1; font-weight: 500;">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" style="background: #111827; border: 1px solid #1e3a5f; color: #f0f4ff;" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label style="color: #cbd5e1; font-weight: 500;">Role</label>
            <select name="roleName" class="form-control" style="background: #111827; border: 1px solid #1e3a5f; color: #f0f4ff;">
                @foreach (var role in ViewBag.Roles)
                {
                    <option value="@role.Name">@role.Name</option>
                }
            </select>
        </div>

        <div style="display: flex; gap: 1rem; align-items: center;">
            <button type="submit" class="btn-admin-primary">
                <i class="fa fa-check"></i> Tạo User
            </button>
            <a asp-action="Index" style="color: #60a5fa; text-decoration: none;">
                <i class="fa fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}