@model Project_385.Models.ViewModels.UserWithRoleViewModel
@{
    ViewData["Title"] = "Chỉnh sửa User";
}
<h3>Chỉnh sửa User</h3>
<a asp-action="Index" class="btn btn-default mb-3">Quay lại</a>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label>Username</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label>Role</label>
        <select name="roleName" class="form-control">
            @foreach (var role in ViewBag.Roles)
            {
                if (role.Name == ViewBag.CurrentRole)
                {
                    <option value="@role.Name" selected>@role.Name</option>
                }
                else
                {
                    <option value="@role.Name">@role.Name</option>
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}