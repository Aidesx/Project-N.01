@model Project_385.Models.RoleModels
@{
    ViewData["Title"] = "Chỉnh sửa Role";
}
<h3>Chỉnh sửa Role</h3>
<a asp-action="Index" class="btn btn-default mb-3">Quay lại</a>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label>Tên Role</label>
        <input asp-for="RoleName" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>Quản lý Sản phẩm</label>
        <select asp-for="CanManageProduct" class="form-control">
            <option value="1">Cho phép</option>
            <option value="0">Không cho phép</option>
        </select>
    </div>
    <div class="form-group mb-3">
        <label>Quản lý Đơn hàng</label>
        <select asp-for="CanManageOrder" class="form-control">
            <option value="1">Cho phép</option>
            <option value="0">Không cho phép</option>
        </select>
    </div>
    <div class="form-group mb-3">
        <label>Quản lý User</label>
        <select asp-for="CanManageUser" class="form-control">
            <option value="1">Cho phép</option>
            <option value="0">Không cho phép</option>
        </select>
    </div>
    <div class="form-group mb-3">
        <label>Quản lý Brand</label>
        <select asp-for="CanManageBrand" class="form-control">
            <option value="1">Cho phép</option>
            <option value="0">Không cho phép</option>
        </select>
    </div>
    <div class="form-group mb-3">
        <label>Quản lý Category</label>
        <select asp-for="CanManageCategory" class="form-control">
            <option value="1">Cho phép</option>
            <option value="0">Không cho phép</option>
        </select>
    </div>
    <div class="form-group mb-3">
        <label>Trạng thái</label>
        <select asp-for="Status" class="form-control">
            <option value="1">Hoạt động</option>
            <option value="0">Tắt</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
</form>