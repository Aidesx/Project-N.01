@model IEnumerable<CategoryModel>

@{
    ViewData["title"] = "Danh sách danh mục";
}   

<h3>Danh sách danh mục</h3>
<a  asp-action="Create" asp-controller="Category" class="btn btn-primary mb-3">Tạo danh mục mới</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Category Name</th>
            <th scope="col">Category Description</th>
            <th scope="col">Category Slug</th>
            <th scope="col">Category Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td>@Html.Raw(item.Description)</td>
                <td>@item.Slug</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="text text-success ">Hiện</span>
                    }
                    else
                    {
                        <span class="text text-danger">Ẩn</span>
                    }

                </td>

                <td>
                    <a asp-action="Edit" class= "btn btn-warning btn-sm " asp-controller="Category" asp-route-Id="@item.Id">Chỉnh sửa</a> |
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Category" asp-route-Id="@item.Id">Xoá</a>
            </tr>
        }
        
    </tbody>
</table>
