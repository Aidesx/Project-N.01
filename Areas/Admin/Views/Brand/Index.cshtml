@model IEnumerable<BrandModels>
@{
    ViewData["title"] = "Danh sách nhãn hiệu";
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}
<h3>Danh sách nhãn hiệu</h3>
<a asp-action="Create" asp-controller="Brand" class="btn btn-primary mb-3">Tạo nhãn hiệu mới</a>
<table class="table" id="my_table">
    <thead>
        <tr>
            <th>#</th>
            <th>Brand Name</th>
            <th>Brand Description</th>
            <th>Brand Status</th>
            <th>Brand Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td>@Html.Raw(item.Description)</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="text text-success">Hiện</span>
                    }
                    else
                    {
                        <span class="text text-danger">Ẩn</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-Id="@item.Id" class="btn btn-warning btn-sm">Chỉnh sửa</a>
                    <form asp-action="Delete" asp-route-Id="@item.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm confirmDeletion">Xoá</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (pager != null && pager.TotalPage > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-end">
            @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="1">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                </li>
            }

            @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }

            @if (pager.CurrentPage < pager.TotalPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                </li>
            }
        </ul>
    </nav>
}
