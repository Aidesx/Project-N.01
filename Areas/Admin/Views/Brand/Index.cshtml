@model IEnumerable<BrandModels>
@{
    ViewData["Title"] = "Danh sách thương hiệu";
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}
<div class="admin-card">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <h4 style="margin: 0;"><i class="fa fa-tag"></i> @ViewData["Title"]</h4>
        <a asp-action="Create" asp-controller="Brand" class="btn-admin-primary">
            <i class="fa fa-plus"></i> Tạo thương hiệu mới
        </a>
    </div>
    <div class="table-responsive">
        <table class="table" id="my_table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên thương hiệu</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@Html.Raw(item.Description)</td>
                        <td>
                            @if (item.Status == 1)
                            {
                                <span class="badge" style="background: #065f46; color: #a7f3d0;">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #7f1d1d; color: #fecaca;">Ẩn</span>
                            }
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <a asp-action="Edit" asp-controller="Brand" asp-route-Id="@item.Id" class="btn-admin-primary btn-sm" style="padding:0.25rem 0.75rem; font-size:15px;">
                                    <i class="fa fa-edit"></i> Sửa
                                </a>
                                <form asp-action="Delete" asp-controller="Brand" asp-route-Id="@item.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm confirmDeletion"
                                            style="background:#7f1d1d; color:#fecaca; border:1px solid #b91c1c; padding:0.25rem 0.75rem; font-size:15px;">
                                        <i class="fa fa-trash"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pager != null && pager.TotalPage > 1)
    {
        <ul class="pagination justify-content-end" style="margin-top: 1rem;">
            @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="1">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                </li>
            }
            @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }
            @if (pager.CurrentPage < pager.TotalPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Brand" asp-action="Index" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                </li>
            }
        </ul>
    }
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.confirmDeletion').click(function (e) {
                e.preventDefault();
                var form = $(this).closest('form');
                Swal.fire({
                    title: 'Bạn chắc chắn?',
                    text: 'Thương hiệu sẽ bị xóa vĩnh viễn!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Xóa',
                    background: '#0d1117',
                    color: '#e2e8f0',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
