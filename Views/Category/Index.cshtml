@model IEnumerable<ProductModels>
@{
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}

<link rel="stylesheet" href="~/css/category_index.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="row">
    <!-- Sidebar -->
    <div class="col-sm-3">
        @Html.Partial("_Sidebar")
    </div>

    <!-- Product List -->
    <div class="col-sm-9">
        <div class="features_items">
            <!-- Tiêu đề danh mục -->
            <div class="section-header" style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem;">
                <div style="width:4px; height:22px; border-radius:2px; background:linear-gradient(180deg,#1d4ed8,#3b82f6);"></div>
                <h2 style="font-size:0.9rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:#60a5fa; margin:0;">
                    Danh mục: @ViewBag.CategoryName
                </h2>
            </div>

            <!-- Product Grid -->
            <div class="product-grid">
                @foreach (var item in Model)
                {
                    <div class="product-card">
                        <!-- Ảnh sản phẩm -->
                        <a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id" style="text-decoration:none;">
                            <div class="product-img">
                                <img src="~/images/@item.Image" alt="@item.Name" />
                            </div>
                        </a>

                        <!-- Thông tin -->
                        <div class="card-body">
                            <!-- Danh mục & thương hiệu -->
                            <p class="card-details">Danh mục: @item.Category?.Name</p>
                            <p class="card-details">Thương hiệu: @item.Brand?.Name</p>

                            <!-- Tên sản phẩm -->
                            <a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id" class="card-title">
                                @item.Name
                            </a>

                            <!-- Giá & nút thêm giỏ -->
                            <div class="card-price-row">
                                <div>
                                    <p class="price-current">@item.Price.ToString("#,##0 VND")</p>
                                </div>
                                <button class="btn-add-cart add-to-cart" data-product-id="@item.Id">
                                    <i class="fa fa-shopping-cart"></i> Thêm
                                </button>
                            </div>

                            <!-- Wishlist & Compare (chỉ khi đã đăng nhập) -->
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <div class="card-actions">
                                    <button class="btn-wishlist add-btn-wishlist" data-product-id="@item.Id">
                                        <i class="fa fa-plus-square"></i> Yêu thích
                                    </button>
                                    <button class="btn-compare add-btn-compare" data-product-id="@item.Id">
                                        <i class="fa fa-plus-square"></i> So sánh
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Phân trang (nếu có) -->
            @if (pager != null && pager.TotalPage > 1)
            {
                <ul class="pagination-container">
                    @if (pager.CurrentPage > 1)
                    {
                        <li class="page-item"><a asp-action="Index" asp-route-category="@ViewBag.CategorySlug" asp-route-pg="1">Đầu</a></li>
                        <li class="page-item"><a asp-action="Index" asp-route-category="@ViewBag.CategorySlug" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a></li>
                    }
                    @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
                    {
                        <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                            <a asp-action="Index" asp-route-category="@ViewBag.CategorySlug" asp-route-pg="@pge">@pge</a>
                        </li>
                    }
                    @if (pager.CurrentPage < pager.TotalPage)
                    {
                        <li class="page-item"><a asp-action="Index" asp-route-category="@ViewBag.CategorySlug" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a></li>
                        <li class="page-item"><a asp-action="Index" asp-route-category="@ViewBag.CategorySlug" asp-route-pg="@(pager.TotalPage)">Cuối</a></li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add to cart AJAX
            $(document).on('click', '.add-to-cart', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("Add", "Cart")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm giỏ hàng thành công!',
                                showConfirmButton: false,
                                background: '#0d1117',
                                color: '#e2e8f0',
                                timer: 1500
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi khi thêm giỏ hàng',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });

            // Add to wishlist AJAX
            $(document).on('click', '.add-btn-wishlist', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddWishList", "Home")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm yêu thích thành công!',
                                background: '#0d1117',
                                color: '#e2e8f0',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi khi thêm yêu thích',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });

            // Add to compare AJAX
            $(document).on('click', '.add-btn-compare', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddCompare", "Home")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm so sánh thành công!',
                                background: '#0d1117',
                                color: '#e2e8f0',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi khi thêm so sánh',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });
        });
    </script>
}
