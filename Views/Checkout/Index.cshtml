@using Project_385.Models.ViewModels
@model CartItemViewModel

@{
    ViewData["Title"] = "Xác nhận Thanh toán";
    ViewData["OrderSummaryMode"] = "Checkout";
}

<link rel="stylesheet" href="~/css/order_summary.css" />
<style>
    .checkout-card{ border-radius: 14px; overflow: hidden; }
</style>

<div class="col-sm-12 checkout-card" aria-label="Xác nhận thanh toán">
    @await Html.PartialAsync("_OrderSummary", Model, ViewData)
</div>

@section Scripts {
    <script>
        (function () {
            // Leaflet map library
            // We include it from CDN in this page to support choosing location by clicking on map.

            const storeLat = parseFloat(document.getElementById('StoreLatitude')?.value || '0');
            const storeLng = parseFloat(document.getElementById('StoreLongitude')?.value || '0');
            const subtotalText = document.getElementById('subtotal-preview');
            const deliveryText = document.getElementById('delivery-preview');
            const grandTotalText = document.getElementById('grandtotal-preview');
            const distanceText = document.getElementById('distance-preview');
            const feeText = document.getElementById('delivery-fee-preview');
            const statusText = document.getElementById('location-status');
            const submitBtn = document.getElementById('checkout-submit-btn');
            const latInput = document.getElementById('CurrentLatitude');
            const lngInput = document.getElementById('CurrentLongitude');
            const button = document.getElementById('btn-current-location');
            const manualLatInput = document.getElementById('ManualLatitude');
            const manualLngInput = document.getElementById('ManualLongitude');
            const manualButton = document.getElementById('btn-use-manual-location');

            // Leaflet map (OpenStreetMap) for manual location picking
            // Note: We load scripts in the browser via CDN below.

            if (!button) return;

            const subtotal = parseMoney(subtotalText?.innerText || '0');

            function parseMoney(value) {
                const cleaned = (value || '').replace(/[^\d]/g, '');
                return parseInt(cleaned || '0', 10);
            }

            function formatMoney(value) {
                return new Intl.NumberFormat('vi-VN').format(Math.round(value)) + ' VND';
            }

            function toRad(value) {
                return value * Math.PI / 180;
            }

            function haversine(lat1, lon1, lat2, lon2) {
                const r = 6371;
                const dLat = toRad(lat2 - lat1);
                const dLon = toRad(lon2 - lon1);
                const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
                    Math.sin(dLon / 2) * Math.sin(dLon / 2);
                return r * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            }

            function getDiscountRate(distanceKm) {
                if (distanceKm > 50) return 0.30;
                if (distanceKm > 20) return 0.10;
                return 0;
            }

            function updateState(message, distanceKm, deliveryFee, canSubmit) {
                if (statusText) statusText.textContent = message;
                if (distanceText) distanceText.textContent = typeof distanceKm === 'number' ? distanceKm.toFixed(2) + ' km' : '--';
                if (feeText) feeText.textContent = typeof deliveryFee === 'number' ? formatMoney(deliveryFee) : '0 VND';
                if (deliveryText) deliveryText.textContent = typeof deliveryFee === 'number' ? formatMoney(deliveryFee) : '0 VND';
                if (grandTotalText) grandTotalText.textContent = formatMoney(subtotal + (deliveryFee || 0));
                if (submitBtn) submitBtn.disabled = !canSubmit;
            }

            // ---- Leaflet map picker ----
            const deliveryMapEl = document.getElementById('delivery-map');
            let map = null;
            let marker = null;

            function setManualFromLatLng(lat, lng) {
                if (Number.isNaN(lat) || Number.isNaN(lng)) return;
                // Put values to hidden inputs used by checkout form
                if (latInput) latInput.value = lat;
                if (lngInput) lngInput.value = lng;
                if (manualLatInput) manualLatInput.value = lat;
                if (manualLngInput) manualLngInput.value = lng;

                // Update fee/distance via existing logic
                applyManualLocation(lat, lng);

                // Ensure marker exists and moves
                if (marker) marker.setLatLng([lat, lng]);
            }

            function initLeafletMap() {
                if (!deliveryMapEl) return;
                if (typeof window.L === 'undefined') {
                    updateState('Chưa tải được bản đồ. Vui lòng thử lại.', null, 0, false);
                    return;
                }

                map = L.map('delivery-map', { zoomControl: true }).setView([storeLat || 0, storeLng || 0], 12);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);

                marker = L.marker([storeLat || 0, storeLng || 0], { draggable: false }).addTo(map);

                map.on('click', function (e) {
                    const lat = e.latlng.lat;
                    const lng = e.latlng.lng;
                    setManualFromLatLng(lat, lng);
                });
            }


            function applyManualLocation(currentLat, currentLng) {
                const distanceKm = haversine(currentLat, currentLng, storeLat, storeLng);

                latInput.value = currentLat;
                lngInput.value = currentLng;

                if (distanceKm > 100) {
                    updateState('Khoảng cách vượt quá 100km, không thể thanh toán.', distanceKm, 0, false);
                    return;
                }

                const rawFee = Math.ceil(distanceKm) * 10000;
                const deliveryFee = rawFee * (1 - getDiscountRate(distanceKm));
                const roundedFee = Math.round(deliveryFee);
                const suffix = distanceKm > 50 ? 'giảm 30%' : (distanceKm > 20 ? 'giảm 10%' : 'không giảm');
                updateState(`Đã xác định vị trí, ${suffix}.`, distanceKm, roundedFee, true);
            }

            if (manualButton) {
                manualButton.addEventListener('click', function () {
                    const lat = parseFloat(manualLatInput?.value || '');
                    const lng = parseFloat(manualLngInput?.value || '');

                    if (Number.isNaN(lat) || Number.isNaN(lng)) {
                        updateState('Vui lòng chọn vị trí trên bản đồ trước.', null, 0, false);
                        return;
                    }

                    applyManualLocation(lat, lng);
                });
            }


            // Ensure Leaflet is loaded, then init.
            function loadLeafletAndInit() {
                if (!deliveryMapEl) return;

                // If already loaded, init immediately
                if (typeof window.L !== 'undefined') {
                    initLeafletMap();
                    return;
                }

                const leafletCssId = 'leaflet-css';
                const leafletJsId = 'leaflet-js';

                // Load CSS
                if (!document.getElementById(leafletCssId)) {
                    const link = document.createElement('link');
                    link.id = leafletCssId;
                    link.rel = 'stylesheet';
                    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                    document.head.appendChild(link);
                }

                // Load JS
                if (!document.getElementById(leafletJsId)) {
                    const script = document.createElement('script');
                    script.id = leafletJsId;
                    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                    script.onload = function () {
                        initLeafletMap();
                    };
                    script.onerror = function () {
                        updateState('Chưa tải được bản đồ. Vui lòng thử lại.', null, 0, false);
                    };
                    document.body.appendChild(script);
                } else {
                    // Script tag exists; wait a bit for L
                    const t = setInterval(function () {
                        if (typeof window.L !== 'undefined') {
                            clearInterval(t);
                            initLeafletMap();
                        }
                    }, 150);
                    setTimeout(function () {
                        clearInterval(t);
                    }, 5000);
                }
            }

            loadLeafletAndInit();


            button.addEventListener('click', function () {
                if (!navigator.geolocation) {




                    updateState('Trình duyệt không hỗ trợ lấy vị trí hiện tại.', null, 0, false);
                    return;
                }

                statusText.textContent = 'Đang lấy vị trí hiện tại...';
                navigator.geolocation.getCurrentPosition(function (position) {
                    const currentLat = position.coords.latitude;
                    const currentLng = position.coords.longitude;
                    const distanceKm = haversine(currentLat, currentLng, storeLat, storeLng);

                    latInput.value = currentLat;
                    lngInput.value = currentLng;

                    if (distanceKm > 100) {
                        updateState('Khoảng cách vượt quá 100km, không thể thanh toán.', distanceKm, 0, false);
                        return;
                    }

                    const rawFee = Math.ceil(distanceKm) * 10000;
                    const deliveryFee = rawFee * (1 - getDiscountRate(distanceKm));
                    const roundedFee = Math.round(deliveryFee);
                    const suffix = distanceKm > 50 ? 'giảm 30%' : (distanceKm > 20 ? 'giảm 10%' : 'không giảm');
                    applyManualLocation(currentLat, currentLng);
                }, function (error) {

                    let message = 'Không thể lấy vị trí hiện tại.';
                    if (error && error.code === error.PERMISSION_DENIED) {
                        message = 'Bạn đã từ chối cấp quyền vị trí.';
                    }
                    updateState(message, null, 0, false);
                }, {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                });
            });
        })();
    </script>
}
