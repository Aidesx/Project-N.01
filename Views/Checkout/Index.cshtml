@using Project_385.Models.ViewModels
@model CartItemViewModel

@{
    ViewData["Title"] = "Xác nhận Thanh toán";
}

<div class="container" style="margin-top: 50px;">
    <h2>Xác nhận Đơn hàng</h2>
    <p>Tổng số tiền bạn cần thanh toán là: <strong>@Model.GrandTotal.ToString("#,##0") VND</strong></p>

    <form method="post" asp-controller="CheckOut" asp-action="CheckOut">
        <button type="submit" class="btn btn-danger">Xác nhận & Thanh toán qua MoMo</button>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-default">Quay lại giỏ hàng</a>
    </form>
    
</div>