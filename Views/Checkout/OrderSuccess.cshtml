@model Project_385.Models.OrderModels
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden; background: #ffffff;">
        <div class="card-body p-4 p-md-5 text-center" style="background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);">
            <div style="width: 72px; height: 72px; background: #dcfce7; color: #16a34a; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 32px;">
                <i class="fa fa-check"></i>
            </div>
            <h2 class="fw-bold mb-2" style="color: #14532d;">Đặt hàng thành công!</h2>
            <p class="text-muted mb-4">Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.</p>

            <div class="p-3 mb-4 text-start" style="background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted d-block small">Mã đơn hàng</span>
                        <strong class="text-dark fs-5">#@Model.OrderNumber</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block small">Ngày đặt</span>
                        <strong class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block small">Người nhận</span>
                        <strong class="text-dark">@Model.ReceiverName (@Model.PhoneNumber)</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted d-block small">Phương thức thanh toán</span>
                        <span class="badge bg-primary">@(Model.PaymentMethod == "MoMo" ? "Ví điện tử MoMo" : "Thanh toán khi nhận hàng (COD)")</span>
                    </div>
                    <div class="col-12">
                        <span class="text-muted d-block small">Địa chỉ nhận hàng</span>
                        <strong class="text-dark">@Model.ShippingAddress</strong>
                    </div>
                </div>
            </div>

            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
            {
                <h5 class="text-start fw-bold mb-3" style="color: #1e293b;">Chi tiết sản phẩm</h5>
                <div class="table-responsive text-start mb-4">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("#,##0 VND")</td>
                                    <td class="text-end fw-semibold">@((item.Price * item.Quantity).ToString("#,##0 VND"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end fs-6">Tổng thanh toán:</th>
                                <th class="text-end fs-5 text-danger">@Model.Total.ToString("#,##0 VND")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                    <i class="fa fa-shopping-bag me-1"></i> Tiếp tục mua sắm
                </a>
            </div>
        </div>
    </div>
</div>
