@using Project_385.Models.MoMo
@model MomoExecuteResponseModel

@{
    ViewData["Title"] = "Thanh toán thành công";
}

<section id="cart_items">
    <div class="container" style="margin-top: 50px; margin-bottom: 50px; text-align: center;">

        <h2 style="color: #28a745;">🎉 Thanh toán thành công!</h2>
        <p>Cảm ơn bạn đã đặt hàng tại Project 385.</p>

        <div style="border: 1px solid #ddd; padding: 20px; max-width: 500px; margin: 0 auto; text-align: left; background-color: #f9f9f9;">
            <p><strong>Mã đơn hàng (OrderId):</strong> @Model.OrderId</p>
            <p><strong>Nội dung:</strong> @Model.OrderInfo</p>
            <p><strong>Tổng tiền:</strong> @Convert.ToDouble(Model.Amount).ToString("#,##0") VND</p>
        </div>

        <div style="margin-top: 30px;">
            <a class="btn btn-primary" asp-controller="Account" asp-action="History">Xem lịch sử đơn hàng</a>
            <a class="btn btn-default" asp-controller="Home" asp-action="Index">Về trang chủ</a>
        </div>

    </div>
</section>