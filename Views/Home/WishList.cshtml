@using Project_385.Models.ViewModels
@model List<WishListViewModel>
@{
    ViewData["Title"] = "Danh sách yêu thích";
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="page-shell">
    <section class="page-card wish-compare-card" aria-label="Danh sách yêu thích">
        <div class="section-title">
            <h4 class="section-title-label"><i class="fa fa-heart"></i> @ViewData["Title"]</h4>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table data-table" id="my_table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tên sản phẩm</th>
                            <th>Mô tả</th>
                            <th>Giá</th>
                            <th>Ảnh</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 0;
                        }
                        @foreach (var item in Model)
                        {
                            index++;
                            <tr>
                                <td>@index</td>
                                <td>@item.Product.Name</td>
                                <td>@Html.Raw(item.Product.Description)</td>
                                <td>@item.Product.Price.ToString("#,##0 VND")</td>
                                <td>
                        <img src="~/images/@item.Product.Image" alt="@item.Product.Name" class="wishlist-thumb" />
                                </td>
                                <td>
                                    <a class="btn-page-danger confirmDeletion"
                                       asp-action="RemoveWishList" asp-controller="Home" asp-route-Id="@item.WishList.Id">
                                        <i class="fa fa-trash"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pager != null && pager.TotalPage > 1)
            {
                <ul class="pagination justify-content-end wishlist-pagination" role="navigation" aria-label="Phân trang">
                    @if (pager.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="WishList" asp-route-pg="1">Đầu</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-action="WishList" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                        </li>
                    }
                    @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
                    {
                        <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="WishList" asp-route-pg="@pge">@pge</a>
                        </li>
                    }
                    @if (pager.CurrentPage < pager.TotalPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="WishList" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-action="WishList" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fa fa-heart"></i>
                <p>Danh sách yêu thích của bạn đang trống.</p>
            </div>
        }
    </section>
</div>
