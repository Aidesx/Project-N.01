@model IEnumerable<ProductModels>
@{
    var pager = ViewBag.Pager as Project_385.Models.Paginate;
}

<div class="col-sm-3">
    @Html.Partial("_Sidebar")
</div>
<style>
    .product-image-wrapper {
        height: 400px;
    }
</style>
<div class="col-sm-9 padding-right">
    <div class="features_items">
        <h2 class="title text-center">Features Items</h2>
        @foreach (var item in Model)
        {
            <div class="col-sm-4">
                <div class="product-image-wrapper">

                    <div class="single-products">

                        <div class="productinfo text-center">
                            <a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id">
                                <img src="~/images/@item.Image" alt="@item.Name" width="100%" />
                                <h2>@item.Price.ToString("#,##0 VND")</h2>
                                <p>@item.Name</p>
                                <p>Danh mục: @item.Category.Name</p>
                                <p>Thương hiệu: @item.Brand.Name</p>
                            </a>
                            <button class="btn btn-default add-to-cart" data-product-id="@item.Id"><i class="fa fa-shopping-cart"></i>Add to cart</button>
                        </div>
                    </div>

                    <div class="choose">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <ul class="nav nav-pills nav-justified">
                                <li><a asp-action="WishList" asp-controller="Home" class="btn btn-default add-btn-wishlist" data-product-id="@item.Id">Add to wishlist</a></li>
                                <li><a asp-action="Compare" asp-controller="Home"  class="btn btn-default add-btn-compare" data-product-id="@item.Id">Add to compare</a></li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (pager != null && pager.TotalPage > 1)
    {
        <ul class="pagination">
            @if (pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-pg="1">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-pg="@(pager.CurrentPage - 1)">Trước</a>
                </li>
            }

            @for (var pge = pager.PageStart; pge <= pager.PageEnd; pge++)
            {
                <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }

            @if (pager.CurrentPage < pager.TotalPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-pg="@(pager.CurrentPage + 1)">Tiếp</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-pg="@(pager.TotalPage)">Cuối</a>
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.add-to-cart').click(function () {
                var Id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("Add", "Cart")',
                    type: 'POST',
                    data: { Id: Id },
                    success: function (result) {
                        if (result) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm giỏ hàng thành công!',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function (result) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi với việc thêm giỏ hàng'
                        });
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.add-btn-wishlist').click(function (e) {
                e.preventDefault();
                var Id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddWishList", "Home")',
                    type: 'POST',
                    data: { Id: Id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm yêu thích thành công!',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function (result) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi với việc thêm yêu thích'
                        });
                    }
                });
            });
        });
    </script>
        
    <script>
        $(document).ready(function () {
            $('.add-btn-compare').click(function (e) {
                 e.preventDefault();
                var Id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddCompare", "Home")',
                    type: 'POST',
                    data: { Id: Id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm so sánh thành công!',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function (result) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi với việc thêm so sánh'
                        });
                    }
                });
            });
        });
    </script>
}