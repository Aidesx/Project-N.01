@{
    ViewData["Title"] = "404 - Not Found";
}

<div class="page-shell narrow">
    <div class="empty-state page-card notfound-card">
        <div class="error-code">404</div>
        <div class="error-title-lg">Không tìm thấy trang</div>
        <p class="error-text">
            Trang bạn đang tìm kiếm không tồn tại hoặc đã bị xóa. Vui lòng kiểm tra lại URL hoặc quay về trang chủ để tiếp tục khám phá.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn-page-primary">
            <i class="fa fa-home"></i> Quay về trang chủ
        </a>
    </div>
</div>
