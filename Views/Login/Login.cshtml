@model Project_385.Models.LoginModels
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="col-sm-4 col-sm-offset-1">
    <div class="login-form">
        <h2>Đăng nhập hệ thống</h2>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="UserName" type="text" placeholder="Tên đăng nhập" class="form-control mb-2" />
            <input asp-for="Password" type="password" placeholder="Mật khẩu" class="form-control mb-2" />

            <button type="submit" class="btn btn-default">Đăng nhập</button>
        </form>
        <p class="mt-3">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
    </div>
</div>