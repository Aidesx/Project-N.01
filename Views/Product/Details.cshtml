@using Project_385.Models
@using Project_385.Models.ViewModels
@model ProductDetailViewModels
@{
    var relatedByCategory = ViewBag.RelatedByCategory as List<ProductModels> ?? new List<ProductModels>();
    var relatedByBrand = ViewBag.RelatedByBrand as List<ProductModels> ?? new List<ProductModels>();
}

<link rel="stylesheet" href="~/css/product_detail.css" />

<div class="row">
    <div class="col-sm-3">
        <partial name="_Sidebar" />
    </div>

    <div class="col-sm-9">
        <div class="product-details">
            <div class="product-main">
                <div class="product-img-box">
                    <img src="~/images/@Model.Product.Image" alt="@Model.Product.Name" onerror="this.onerror=null;this.src='/images/default.png';" />
                </div>

                <div class="product-info-box">
                    <h2>@Model.Product.Name</h2>

                    <div class="price-section">
                        <span class="price-current">@Model.Product.Price.ToString("N0") đ</span>
                    </div>

                    <div class="quantity-box">
                        <span>Số lượng:</span>
                        <input type="number" value="1" min="1" class="form-control" />
                    </div>

                    <div class="product-action-group">
                        <button type="button" class="btn-add-cart add-to-cart" data-product-id="@Model.Product.Id">
                            <i class="fa fa-shopping-cart"></i> Thêm vào giỏ
                        </button>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <button type="button" class="btn-wishlist add-btn-wishlist" data-product-id="@Model.Product.Id">
                                <i class="fa fa-heart"></i> Yêu thích
                            </button>
                            <button type="button" class="btn-compare add-btn-compare" data-product-id="@Model.Product.Id">
                                <i class="fa fa-exchange"></i> So sánh
                            </button>
                        }
                    </div>

                    <div class="meta-info">
                        <p><b>Availability:</b> <span class="availability-in-stock">In Stock</span></p>
                        <p><b>Condition:</b> <span>Mới</span></p>
                        <p><b>Brand:</b> <span>@Model.Product.Brand.Name</span></p>
                        <p><b>Category:</b> <span>@Model.Product.Category.Name</span></p>
                    </div>

                    <a href="#" class="share-link">
                        <img src="~/images/share.png" class="share img-responsive" alt="Share" />
                    </a>
                </div>
            </div>
        </div>

        <div class="category-tab shop-details-tab">
            <div class="col-sm-12">
                <ul class="nav nav-tabs">
                    <li><a href="#details" data-toggle="tab">Mô tả</a></li>
                    <li><a href="#companyprofile" data-toggle="tab">Cùng thương hiệu</a></li>
                    <li><a href="#tag" data-toggle="tab">Cùng danh mục</a></li>
                    <li class="active"><a href="#reviews" data-toggle="tab">Đánh giá (@Model.Ratings.Count)</a></li>
                </ul>
            </div>

            <div class="tab-content">
                <div class="tab-pane fade" id="details">
                    <div class="col-sm-12">
                        @Html.Raw(Model.Product.Description)
                    </div>
                </div>

                <div class="tab-pane fade" id="companyprofile">
                    <div class="mini-product-grid">
                        @foreach (var related in relatedByBrand)
                        {
                            <div class="mini-product-card">
                                <a asp-action="Details" asp-controller="Product" asp-route-id="@related.Id">
                                    <img src="~/images/@related.Image" alt="@related.Name" />
                                </a>
                                <div class="caption">
                                    <h5>@related.Name</h5>
                                    <div class="price">@related.Price.ToString("N0") đ</div>
                                    <button type="button" class="btn-add-cart add-to-cart" data-product-id="@related.Id">
                                        <i class="fa fa-shopping-cart"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="tag">
                    <div class="mini-product-grid">
                        @foreach (var related in relatedByCategory)
                        {
                            <div class="mini-product-card">
                                <a asp-action="Details" asp-controller="Product" asp-route-id="@related.Id">
                                    <img src="~/images/@related.Image" alt="@related.Name" />
                                </a>
                                <div class="caption">
                                    <h5>@related.Name</h5>
                                    <div class="price">@related.Price.ToString("N0") đ</div>
                                    <button type="button" class="btn-add-cart add-to-cart" data-product-id="@related.Id">
                                        <i class="fa fa-shopping-cart"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade active in" id="reviews">
                    <div class="col-sm-12">
                        @if (Model.Ratings != null && Model.Ratings.Any())
                        {
                            foreach (var review in Model.Ratings)
                            {
                                <div class="review-item">
                                    <div class="review-header">
                                        <strong><i class="fa fa-user"></i> @review.Name</strong>
                                        <span class="review-email"><i class="fa fa-envelope"></i> @review.Email</span>
                                    </div>
                                    <div class="star-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (int.TryParse(review.Rating, out int rVal) && i <= rVal)
                                            {
                                                <i class="fa fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="fa fa-star-o"></i>
                                            }
                                        }
                                    </div>
                                    <p>@review.Comment</p>
                                </div>
                            }
                        }

                        <p class="review-title"><b>Viết đánh giá của bạn</b></p>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (ViewBag.HasReviewed)
                            {
                                <div class="alert alert-info ui-alert">
                                    Bạn đã gửi đánh giá cho sản phẩm này. Mỗi tài khoản chỉ được đánh giá một lần.
                                </div>
                            }
                            else
                            {
                                <form autocomplete="off" asp-action="CommentProduct" asp-controller="Product" method="post" class="review-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="Rating.ProductId" value="@Model.Product.Id" />

                                    <div class="form-group">
                                        <label>Tên</label>
                                        <input asp-for="Rating.Name" type="text" value="@ViewBag.UserName" readonly class="form-control" />
                                    </div>
                                    <div class="form-group">
                                        <label>Email</label>
                                        <input asp-for="Rating.Email" type="email" value="@ViewBag.UserEmail" readonly class="form-control" />
                                    </div>
                                    <div class="form-group">
                                        <label>Bình luận</label>
                                        <textarea asp-for="Rating.Comment" class="form-control" rows="4" placeholder="Viết cảm nghĩ của bạn..."></textarea>
                                        <span asp-validation-for="Rating.Comment" class="text-danger"></span>
                                    </div>

                                    <div class="rating-row">
                                        <label>Rating:</label>
                                        <span id="star-rating" class="star-picker">
                                            <i class="fa fa-star" data-value="1"></i>
                                            <i class="fa fa-star" data-value="2"></i>
                                            <i class="fa fa-star" data-value="3"></i>
                                            <i class="fa fa-star" data-value="4"></i>
                                            <i class="fa fa-star" data-value="5"></i>
                                        </span>
                                        <input type="hidden" asp-for="Rating.Rating" id="RatingValue" value="5" />
                                    </div>

                                    <button type="submit" class="btn-submit-review">Gửi đánh giá</button>
                                </form>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning ui-alert warning">
                                Vui lòng <a asp-area="" asp-controller="Account" asp-action="Login">đăng nhập</a> để đánh giá.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="recommended_items">
            <h2><i class="fa fa-star"></i> Sản phẩm đề xuất</h2>
            <div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner">
                    @{
                        int recCount = 0;
                        foreach (var related in relatedByBrand)
                        {
                            if (recCount % 3 == 0)
                            {
                                string activeClass = recCount == 0 ? "active" : "";
                                @Html.Raw($"<div class=\"item {activeClass}\"><div class=\"row\">")
                            }

                            <div class="col-sm-4">
                                <div class="mini-product-card compact">
                                    <a asp-action="Details" asp-controller="Product" asp-route-id="@related.Id">
                                        <img src="~/images/@related.Image" alt="@related.Name" onerror="this.onerror=null;this.src='/images/default.png';" />
                                    </a>
                                    <div class="caption">
                                        <h5>@related.Name</h5>
                                        <div class="price">@related.Price.ToString("N0") đ</div>
                                        <button type="button" class="btn-add-cart add-to-cart" data-product-id="@related.Id">
                                            <i class="fa fa-shopping-cart"></i> Thêm
                                        </button>
                                    </div>
                                </div>
                            </div>

                            if (recCount % 3 == 2 || recCount == relatedByBrand.Count - 1)
                            {
                                @Html.Raw("</div></div>")
                            }
                            recCount++;
                        }
                    }
                </div>
                <a class="left carousel-control" href="#recommended-item-carousel" data-slide="prev">
                    <i class="fa fa-angle-left"></i>
                </a>
                <a class="right carousel-control" href="#recommended-item-carousel" data-slide="next">
                    <i class="fa fa-angle-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#star-rating i').on('click', function () {
                var selectedValue = $(this).data('value');
                $('#RatingValue').val(selectedValue);

                $('#star-rating i').each(function () {
                    if ($(this).data('value') <= selectedValue) {
                        $(this).removeClass('fa-star-o').addClass('fa-star');
                    } else {
                        $(this).removeClass('fa-star').addClass('fa-star-o');
                    }
                });
            });

            $(document).on('click', '.add-to-cart', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("Add", "Cart")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Đã thêm vào giỏ hàng!',
                                background: '#0d1117',
                                color: '#e2e8f0',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi xảy ra',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });

            $(document).on('click', '.add-btn-wishlist', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddWishList", "Home")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã thêm vào yêu thích',
                                showConfirmButton: false,
                                timer: 1500,
                                background: '#0d1117',
                                color: '#e2e8f0'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể thêm yêu thích',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });

            $(document).on('click', '.add-btn-compare', function (e) {
                e.preventDefault();
                var id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("AddCompare", "Home")',
                    type: 'POST',
                    data: { Id: id },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã thêm vào so sánh',
                                showConfirmButton: false,
                                timer: 1500,
                                background: '#0d1117',
                                color: '#e2e8f0'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể thêm so sánh',
                            background: '#0d1117',
                            color: '#e2e8f0'
                        });
                    }
                });
            });
        });

        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');

        function showSlide(index) {
            if (slides.length === 0) return;
            $('.hero-slide').removeClass('active');
            $(slides[index]).addClass('active');
            currentSlide = index;
        }

        function changeSlide(dir) {
            showSlide((currentSlide + dir + slides.length) % slides.length);
        }

        if (slides.length > 0) {
            setInterval(() => changeSlide(1), 5000);
        }
    </script>
}
