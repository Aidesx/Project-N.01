@model ProductModels
@{
    var relatedByCategory = ViewBag.RelatedByCategory as List<ProductModels> ?? new List<ProductModels>();
    var relatedByBrand = ViewBag.RelatedByBrand as List<ProductModels> ?? new List<ProductModels>();
}
}

<div class="row">
    <div class="col-sm-3">
        @Html.Partial("_Sidebar")
    </div>

    <div class="col-sm-9 padding-right">
        <div class="product-details">
            <div class="col-sm-5">
                <div class="view-product">
                    <img src="~/images/@Model.Image" class="newarrival" alt="@Model.Name" />
                </div>

            </div>
            <div class="col-sm-7">
                <div class="product-information">
                    <h2>@Model.Name</h2>
                    <span>
                        <span>@Model.Price.ToString("N0") đ</span>
                        <input type="text" value="1" />
                        <button type="button" class="btn btn-default cart add-to-cart" data-product-id="@Model.Id">
                            <i class="fa fa-shopping-cart"></i>
                            Add to cart
                        </button>
                    </span>
                    <p><b>Availability:</b> In Stock</p>
                    <p><b>Condition:</b> New</p>
                    <p><b>Brand:</b> @Model.Brand.Name</p>
                    <p><b>Category:</b> @Model.Category.Name</p>
                </div>
            </div>
        </div><div class="category-tab shop-details-tab">
            <div class="col-sm-12">
                <ul class="nav nav-tabs">
                    <li><a href="#details" data-toggle="tab">Details</a></li>
                    <li><a href="#companyprofile" data-toggle="tab">Company Profile</a></li>
                    <li><a href="#tag" data-toggle="tab">Tag</a></li>
                    <li class="active"><a href="#reviews" data-toggle="tab">Reviews</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div class="tab-pane fade" id="details">
                    @Html.Raw(Model.Description)
                </div>

                <div class="tab-pane fade" id="companyprofile">
                    @foreach (var related in relatedByBrand)
                    {
                        <div class="col-sm-3">
                            <div class="product-image-wrapper">
                                <div class="single-products">
                                    <div class="productinfo text-center">
                                        <a asp-action="Details" asp-controller="Product" asp-route-Id="@related.Id">
                                            <img src="~/images/@related.Image" alt="@related.Name" />
                                            <h2>@related.Price.ToString("N0") đ</h2>
                                            <p>@related.Name</p>
                                        </a>
                                        <button type="button" class="btn btn-default add-to-cart" data-product-id="@related.Id">
                                            <i class="fa fa-shopping-cart"></i>Add to cart
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-pane fade" id="tag">
                    @foreach (var related in relatedByCategory)
                    {
                        <div class="col-sm-3">
                            <div class="product-image-wrapper">
                                <div class="single-products">
                                    <div class="productinfo text-center">
                                        <a asp-action="Details" asp-controller="Product" asp-route-Id="@related.Id">
                                            <img src="~/images/@related.Image" alt="@related.Name" />
                                            <h2>@related.Price.ToString("N0") đ</h2>
                                            <p>@related.Name</p>
                                        </a>
                                        <button type="button" class="btn btn-default add-to-cart" data-product-id="@related.Id">
                                            <i class="fa fa-shopping-cart"></i>Add to cart
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-pane fade active in" id="reviews">
                    <div class="col-sm-12">
                        <ul>
                            <li><a href=""><i class="fa fa-user"></i>@Model.Brand.Name</a></li>
                            <li><a href=""><i class="fa fa-clock-o"></i>@DateTime.Now.ToString("HH:mm")</a></li>
                            <li><a href=""><i class="fa fa-calendar-o"></i>@DateTime.Now.ToString("dd MMM yyyy")</a></li>
                        </ul>
                        <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        <p><b>Write Your Review</b></p>

                        <form action="#">
                            <span>
                                <input type="text" placeholder="Your Name" />
                                <input type="email" placeholder="Email Address" />
                            </span>
                            <textarea name=""></textarea>
                            <b>Rating: </b> <img src="~/images/product-details/rating.png" alt="" />
                            <button type="button" class="btn btn-default pull-right">Submit </button>
                        </form>
                    </div>
                </div>

            </div>
        </div><div class="recommended_items">
            <h2 class="title text-center">recommended items</h2>

            <div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner">
                    @{
                        int count = 0;
                        foreach (var related in relatedByBrand)
                        {
                            if (count % 3 == 0)
                            {
                                string activeClass = count == 0 ? "active" : "";
                                @Html.Raw($"<div class=\"item {activeClass}\">")
                            }

                            <div class="col-sm-4">
                                <div class="product-image-wrapper">
                                    <div class="single-products">
                                        <div class="productinfo text-center">
                                            <a asp-action="Details" asp-controller="Product" asp-route-Id="@related.Id">
                                                <img src="~/images/@related.Image" alt="@related.Name" />
                                                <h2>@related.Price.ToString("N0") đ</h2>
                                                <p>@related.Name</p>
                                            </a>
                                            <button type="button" class="btn btn-default add-to-cart" data-product-id="@related.Id">
                                                <i class="fa fa-shopping-cart"></i>Add to cart
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            if (count % 3 == 2 || count == relatedByBrand.Count - 1)
                            {
                                @Html.Raw("</div>")
                            }
                            count++;
                        }
                    }
                </div>
                <a class="left recommended-item-control" href="#recommended-item-carousel" data-slide="prev">
                    <i class="fa fa-angle-left"></i>
                </a>
                <a class="right recommended-item-control" href="#recommended-item-carousel" data-slide="next">
                    <i class="fa fa-angle-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.add-to-cart').click(function () {
                var Id = $(this).data('product-id');
                $.ajax({
                    url: '@Url.Action("Add", "Cart")',
                    type: 'POST',
                    data: { Id: Id },
                    success: function (result) {
                        if (result) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Thêm giỏ hàng thành công!',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },
                    error: function (result) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thất bại',
                            text: 'Có lỗi với việc thêm giỏ hàng'
                        });
                    }
                });
            });
        });
    </script>
}