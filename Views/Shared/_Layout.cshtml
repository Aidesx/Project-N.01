@using System.Globalization
@using Microsoft.Extensions.Options
@using Project_385.Models
@using Project_385.Services
@inject IOptions<DeliverySettingsModel> _deliverySettings
@inject PermissionService _permissionService
@{
	var deliverySettings = _deliverySettings.Value;
	var shopName = string.IsNullOrWhiteSpace(deliverySettings.ShopName) ? "The Awesome Store" : deliverySettings.ShopName;
	var footerMapSrc = string.Format(
		CultureInfo.InvariantCulture,
		"https://www.google.com/maps?q={0},{1}&z=16&output=embed",
		deliverySettings.StoreLatitude,
		deliverySettings.StoreLongitude);
}
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="">
	<meta name="author" content="">
	<title>@(ViewData["Title"] ?? shopName) | @shopName</title>

	<link href="~/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
	<script>
		window.tailwind = window.tailwind || {};
		window.tailwind.config = window.tailwind.config || { corePlugins: { preflight: false } };
	</script>
	<!-- <script src="https://cdn.tailwindcss.com"></script> -->
	<link href="~/css/prettyPhoto.css" rel="stylesheet">
	<link href="~/css/price-range.css" rel="stylesheet">
	<link href="~/css/animate.css" rel="stylesheet">
	<link href="~/css/main.css" rel="stylesheet">
	<link href="~/css/responsive.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.24/dist/sweetalert2.all.min.js"></script>
	<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.24/dist/sweetalert2.min.css" rel="stylesheet">
	<link rel="stylesheet" href="~/css/layout.css">
	<link rel="stylesheet" href="~/css/design_tokens.css">
	<link rel="shortcut icon" href="images/ico/favicon.ico">
</head>

<body>
	<header id="header">
		<div class="header-middle">
			<div class="container">
				<div class="row">
					<div class="col-sm-4">
						<div class="logo pull-left site-brand">
							<a asp-controller="Home" asp-action="Index" class="site-brand-link">
								<span class="site-brand-copy">
									<i class="fa fa-shopping-bag site-brand-icon" style="font-size: 1.5rem; color: #3b82f6; margin-right: 0.5rem;"></i>
									<span class="site-brand-name">@shopName</span>
								</span>
							</a>
						</div>
					</div>
					<div class="col-sm-8">
						<div class="shop-menu pull-right">
							<ul class="nav navbar-nav">
								@if (User.Identity?.IsAuthenticated ?? false)
								{
									<li><a asp-action="WishList" asp-controller="Home"><i class="fa fa-star"></i> Wishlist</a></li>
									<li><a asp-action="Compare" asp-controller="Home"><i class="fa fa-star"></i> Compare</a></li>
									<li><a asp-controller="Checkout"><i class="fa fa-lock"></i> Checkout</a></li>
									<li><a asp-controller="Cart" asp-action="Index"><i class="fa fa-shopping-cart"></i>Cart</a></li>
									<li class="dropdown">
										<a href="#" data-toggle="dropdown">
											<i class="fa fa-user"></i> @User.Identity.Name
											<span class="caret"></span>
										</a>
										<ul class="dropdown-menu">
											@if (await _permissionService.CanAccessAdminAsync(User))
											{
												<li>
													<a asp-area="Admin" asp-controller="Product" asp-action="Index">
														<i class="fa fa-lock"></i> Trang quản trị (Admin)
													</a>
												</li>
											}
											<li>
												<a asp-controller="Account" asp-action="History">
													<i class="fa fa-shopping-bag"></i> Đơn hàng của tôi
												</a>
											</li>
											<li>
												<a asp-controller="Account" asp-action="Logout">
													<i class="fa fa-sign-out"></i> Đăng xuất
												</a>
											</li>
										</ul>
									</li>
								}
								else
								{
									<li>
										<a asp-controller="Account" asp-action="Login">
											<i class="fa fa-lock"></i> Login
										</a>
									</li>
								}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="header-bottom">
			<div class="container">
				<div class="row">
					<div class="col-sm-9">
						<div class="navbar-header">
							<button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
								<span class="sr-only">Toggle navigation</span>
								<span class="icon-bar"></span>
								<span class="icon-bar"></span>
								<span class="icon-bar"></span>
							</button>
						</div>
						<div class="mainmenu pull-left">
							<ul class="nav navbar-nav collapse navbar-collapse ">
								<li><a asp-controller="Home" asp-action="Index" class="active">Home</a></li>
								<li class="dropdown">
									<a asp-controller="Product">Shop<i class="fa fa-angle-down"></i></a>
									<ul role="menu" class="sub-menu">
										<li><a asp-action="Index" asp-controller="Category">Category</a></li>
										<li><a asp-action="Index" asp-controller="Product">Product Details</a></li>
										<li><a asp-action="Index" asp-controller="Cart">Cart</a></li>
									</ul>
								</li>
								<li><a asp-controller="Home" asp-action="Error" asp-route-statusCode="404">404</a></li>
								<li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
							</ul>
						</div>
					</div>
					<div class="col-sm-3">
						<form asp-controller="Product" asp-action="Search" method="post">
							<div class="search_box pull-right">
								<input type="text" name="search" placeholder="Search" />
								<button type="submit" class="btn btn-danger">Search</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</header>

	<main class="site-main">
		<div class="container">
			<div class="row">
				@RenderBody()
			</div>
		</div>
	</main>

	<footer class="site-footer">
		<div class="container">
			<div class="footer-grid">
				<div class="footer-column footer-brand-column">
					<div class="footer-brand-head">
						<div>
							<h3><i class="fa fa-shopping-bag" style="color: #3b82f6; margin-right: 0.5rem;"></i>@shopName</h3>
							<p>Hệ thống mua sắm công nghệ tập trung vào sự rõ ràng, tốc độ và trải nghiệm đồng nhất.</p>
						</div>
					</div>
					<div class="footer-social-row">
						<a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
						<a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
						<a href="#" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
						<a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
					</div>
				</div>

				<div class="footer-column footer-location-column">
					<h3>Địa chỉ shop</h3>
					<p class="footer-address">@deliverySettings.StoreAddress</p>
					<div class="footer-map">
						<iframe
							src="@footerMapSrc"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							title="Bản đồ cửa hàng">
						</iframe>
					</div>
				</div>

				<div class="footer-column footer-links-column">
					<h3>Liên kết nhanh</h3>
					<ul class="footer-link-list">
						<li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
						<li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
						<li><a asp-controller="Category" asp-action="Index">Category</a></li>
						<li><a asp-controller="Brand" asp-action="Index">Brand</a></li>
						<li><a asp-controller="Home" asp-action="Compare">So sánh</a></li>
						<li><a asp-controller="Home" asp-action="WishList">Yêu thích</a></li>
					</ul>
					<div class="footer-social-placeholders">
						<a href="#" aria-label="Social 1">Facebook</a>
						<a href="#" aria-label="Social 2">Zalo</a>
						<a href="#" aria-label="Social 3">TikTok</a>
					</div>
				</div>
			</div>

			<div class="footer-bottom">
				<span>© @DateTime.Now.Year @shopName</span>
				<span>03 Quang Trung, Hải Châu, Đà Nẵng, Việt Nam</span>
			</div>
		</div>
	</footer>

	<script src="~/js/jquery.js"></script>
	<script src="~/js/bootstrap.min.js"></script>
	<script src="~/js/jquery.scrollUp.min.js"></script>
	<script src="~/js/price-range.js"></script>
	<script src="~/js/jquery.prettyPhoto.js"></script>
	<script src="~/js/main.js"></script>
	<script src="~/backend/js/site.js"></script>
	<script>
		$(function () {
			var successMessage = '@Html.Raw(TempData["Success"])';
			if (successMessage != '') {
				Swal.fire({
						toast: true,
						position: 'top-end',
						icon: 'success',
						title: 'Thành công!',
						text: successMessage,
						background: '#0d1117',
						color: '#e2e8f0',
						showConfirmButton: false,
						timer: 2500,
						timerProgressBar: true,
						confirmButtonColor: '#3085d6'
					});
			}

			var errorMessage = '@Html.Raw(TempData["Error"])';
			if (errorMessage != '') {
				Swal.fire({
						toast: true,
						position: 'top-end',
						icon: 'error',
						title: 'Thất bại!',
						text: errorMessage,
						background: '#0d1117',
						color: '#e2e8f0',
						showConfirmButton: false,
						timer: 3000,
						timerProgressBar: true,
						confirmButtonColor: '#d33'
					});
			}
		});
	</script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
