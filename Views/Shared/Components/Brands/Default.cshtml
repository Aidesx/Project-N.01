@using Project_385.Models
@model IEnumerable<BrandModels>

@if (Model != null && Model.Any())
{
    <ul style="list-style: none; padding: 0; margin: 0;">
        @foreach (var item in Model.Take(5))
        {
            <li style="border-bottom: 1px solid #1a1f35;">
                <a asp-action="Index" asp-controller="Brand" asp-route-Slug="@item.Slug"
                   style="display: block; padding: 0.6rem 1rem; color: #cbd5e1; text-decoration: none; font-size: 14px; transition: all 0.2s;"
                   onmouseover="this.style.background='#1e293b'; this.style.color='#60a5fa';"
                   onmouseout="this.style.background='transparent'; this.style.color='#cbd5e1';">
                    @item.Name
                </a>
            </li>
        }
    </ul>
}
else
{
    <p style="color: #4b5e7a; padding: 1rem; text-align: center; font-size: 14px;">Chưa có thương hiệu nào.</p>
}