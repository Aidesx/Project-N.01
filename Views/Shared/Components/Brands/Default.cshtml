@using Project_385.Models
@model IEnumerable<BrandModels>

@{
    var currentSlug = ViewContext.RouteData.Values["Slug"]?.ToString() ?? "";
}

@if (Model != null && Model.Any())
{
    <ul class="sidebar-list">
        @foreach (var item in Model.Take(5))
        {
            var isActive = string.Equals(currentSlug, item.Slug, StringComparison.OrdinalIgnoreCase);
            <li>
                <a asp-action="Index" asp-controller="Brand" asp-route-Slug="@item.Slug" class="@(isActive ? "active" : "")">
                    @item.Name
                </a>
            </li>
        }
    </ul>
}
else
{
    <p class="sidebar-empty">Chưa có thương hiệu nào.</p>
}
