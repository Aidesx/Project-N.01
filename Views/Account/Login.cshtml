@model Project_385.Models.ViewModels.LoginViewModels
@{
    ViewData["Title"] = "Đăng nhập";
}

<section id="login-section">
    <div class="container">
        <div class="row">
            <div class="col-sm-12 col-sm-offset-1">
                <div class="login-form">
                    <h2>Đăng nhập vào tài khoản của bạn</h2>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" /> <div class="form-group">
                            <label asp-for="UserName">Tên đăng nhập</label>
                            <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập..." />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">Mật khẩu</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." id="passwordInput" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <span>
                                <input type="checkbox" class="checkbox" onclick="togglePassword()" style="display:inline-block;">
                                Hiển thị mật khẩu
                            </span>
                        </div>

                        <div class="form-group">
                            <span>
                                <input asp-for="RememberMe" type="checkbox" class="checkbox" style="display:inline-block;">
                                Ghi nhớ đăng nhập
                            </span>
                        </div>

                        <button type="submit" class="btn btn-default">Đăng nhập</button>
                        <a asp-action="Create" asp-controller="Account" class="btn btn-primary">Đăng ký</a>
                        <hr />
                        <a asp-action="LoginGoogle" asp-controller="Account"
                           asp-route-returnUrl="@ViewData["ReturnUrl"]"
                           class="btn btn-danger">
                            <i class="fa fa-google"></i> Đăng nhập bằng Google
                        </a>
                    </form>

                    <hr />

                    <form asp-action="ForgotPassword" method="post" style="margin-top:20px;">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label>Quên mật khẩu?</label>
                            <div style="display: flex; gap: 10px;">
                                <input type="email" name="Email" class="form-control" placeholder="Nhập email để lấy lại mật khẩu" required style="max-width: 300px;" />
                                <button type="submit" class="btn btn-warning">Gửi yêu cầu</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function togglePassword() {
        var input = document.getElementById("passwordInput");
        input.type = input.type === "password" ? "text" : "password";
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}