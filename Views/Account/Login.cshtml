@model Project_385.Models.ViewModels.LoginViewModels
@{
    ViewData["Title"] = "Đăng nhập";
}

<link rel="stylesheet" href="~/css/account_login.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="login-card">
    <h2><i class="fa fa-lock"></i> @ViewData["Title"]</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Login" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="form-group">
            <label asp-for="UserName">Tên đăng nhập</label>
            <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập..." />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." id="passwordInput" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="checkbox-inline">
            <input type="checkbox" id="showPassword" onclick="togglePassword()" />
            <label for="showPassword">Hiển thị mật khẩu</label>
        </div>
        <div class="form-group">
            <span>
                <input asp-for="RememberMe" type="checkbox" class="checkbox" style="display:inline-block;">
                Ghi nhớ đăng nhập
            </span>
        </div>
        <div class="button-group" style="display: flex; gap: 1rem; margin-bottom: 1rem;">
            <button type="submit" class="btn-login"><i class="fa fa-sign-in"></i> Đăng nhập</button>
            <a asp-action="Create" asp-controller="Account" class="btn-register"><i class="fa fa-user-plus"></i> Đăng ký</a>
        </div>

        <hr style="border-top: 1px solid #1a1f35; margin: 1.5rem 0;" />

        <a asp-action="LoginGoogle" asp-controller="Account"
           asp-route-returnUrl="@ViewData["ReturnUrl"]"
           class="btn-danger">
            <i class="fa-brands fa-google"></i> Đăng nhập bằng Google
        </a>
    </form>

    <div class="forgot-section">
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <label style="color:#cbd5e1; font-weight:500;">Quên mật khẩu?</label>
            <div style="display: flex; gap: 10px; margin-top: 0.5rem;">
                <input type="email" name="Email" class="form-control" placeholder="Nhập email để lấy lại mật khẩu" required style="max-width:260px;" />
                <button type="submit" class="btn-forgot"><i class="fa fa-envelope"></i> Gửi</button>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePassword() {
        var input = document.getElementById("passwordInput");
        input.type = input.type === "password" ? "text" : "password";
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}