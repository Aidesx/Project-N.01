@{
    ViewData["Title"] = "Quên mật khẩu";
}

<link rel="stylesheet" href="~/css/account_login.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="page-shell narrow">
    <div class="login-card page-card">
        <h2><i class="fa fa-key"></i> @ViewData["Title"]</h2>
        <p style="color: #94a3b8; font-size: 14px; margin-bottom: 20px;">
            Nhập địa chỉ email đăng ký của bạn. Chúng tôi sẽ gửi liên kết để đặt lại mật khẩu.
        </p>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="emailInput">Địa chỉ Email</label>
                <input type="email" id="emailInput" name="email" class="form-control" placeholder="Nhập địa chỉ email của bạn..." required />
            </div>

            <div class="button-group" style="margin-top: 20px;">
                <button type="submit" class="btn-login"><i class="fa fa-paper-plane"></i> Gửi yêu cầu</button>
                <a asp-action="Login" asp-controller="Account" class="btn-register"><i class="fa fa-arrow-left"></i> Quay lại Đăng nhập</a>
            </div>
        </form>
    </div>
</div>
