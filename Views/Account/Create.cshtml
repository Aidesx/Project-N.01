@model Project_385.Models.UserModels
@{
    ViewData["Title"] = "Đăng ký";
}

<link rel="stylesheet" href="~/css/account_login.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="page-shell narrow">
<div class="login-card page-card">
    <h2><i class="fa fa-user-plus"></i> @ViewData["Title"] tài khoản</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success auth-alert auth-alert-success">
            <i class="fa fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger auth-alert auth-alert-danger">
            <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-action="Create" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="UserName">Tên đăng nhập</label>
            <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập..." />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Nhập địa chỉ email..." />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." id="passwordInput" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu..." id="confirmPasswordInput" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="checkbox-inline">
            <input type="checkbox" id="showPassword" onclick="togglePassword()" />
            <label for="showPassword" class="auth-checkbox-label">Hiển thị mật khẩu</label>
        </div>

        <div class="button-group">
            <button type="submit" class="btn-login"><i class="fa fa-check"></i> Đăng ký</button>
            <a asp-action="Login" asp-controller="Account" class="btn-register"><i class="fa fa-sign-in"></i> Đăng nhập ngay</a>
        </div>
    </form>

    <div class="forgot-section">
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <label>Quên mật khẩu?</label>
            <div class="auth-forgot-section">
                <input type="email" name="Email" class="form-control" placeholder="Nhập email để lấy lại mật khẩu" required />
                <button type="submit" class="btn-forgot"><i class="fa fa-envelope"></i> Gửi</button>
            </div>
        </form>
    </div>
</div>
</div>

<script>
    function togglePassword() {
        var input1 = document.getElementById("passwordInput");
        var input2 = document.getElementById("confirmPasswordInput");
        if (input1.type === "password") {
            input1.type = "text";
            input2.type = "text";
        } else {
            input1.type = "password";
            input2.type = "password";
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
