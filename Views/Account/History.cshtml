@model IEnumerable<Project_385.Models.OrderModels>
@{
    ViewData["Title"] = "Lịch sử đơn hàng của tôi";
}

<div class="container my-5" style="max-width: 960px;">
    <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden; background: #ffffff;">
        <div class="card-header p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fa fa-history me-2"></i> Lịch sử đơn hàng</h3>
                    <p class="mb-0 text-muted small" style="color: #94a3b8 !important;">Theo dõi các đơn hàng bạn đã đặt tại cửa hàng</p>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm" style="border-radius: 8px;">
                    <i class="fa fa-arrow-left me-1"></i> Mua sắm thêm
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            @if (Model != null && Model.Any())
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var order in Model)
                    {
                        <div class="border rounded-3 p-3 p-md-4" style="border-color: #e2e8f0; background: #f8fafc;">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <span class="text-muted small d-block">Mã đơn hàng</span>
                                    <strong class="fs-5 text-dark">#@order.OrderNumber</strong>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Ngày đặt</span>
                                    <span class="text-secondary">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Thanh toán</span>
                                    <span class="badge bg-secondary">
                                        @(order.PaymentMethod == "MoMo" ? "Ví MoMo" : "COD (Tiền mặt)")
                                    </span>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Trạng thái</span>
                                    @switch (order.Status)
                                    {
                                        case 1:
                                            <span class="badge bg-success">Đã thanh toán (MoMo)</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-info text-dark">Đang đóng gói</span>
                                            break;
                                        case 3:
                                            <span class="badge bg-primary">Đang giao hàng</span>
                                            break;
                                        case 4:
                                            <span class="badge bg-success">Hoàn thành</span>
                                            break;
                                        case 5:
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning text-dark">Chờ xử lý (COD)</span>
                                            break;
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(order.ShippingAddress))
                            {
                                <div class="mb-3 p-2 rounded small text-muted" style="background: #ffffff; border: 1px solid #e2e8f0;">
                                    <i class="fa fa-map-marker text-danger me-1"></i>
                                    <strong>Địa chỉ nhận:</strong> @order.ReceiverName (@order.PhoneNumber) - @order.ShippingAddress
                                </div>
                            }

                            @if (order.OrderDetails != null && order.OrderDetails.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted small">
                                                <th>Sản phẩm</th>
                                                <th class="text-center">Số lượng</th>
                                                <th class="text-end">Đơn giá</th>
                                                <th class="text-end">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.OrderDetails)
                                            {
                                                <tr>
                                                    <td><strong>@item.ProductName</strong></td>
                                                    <td class="text-center">@item.Quantity</td>
                                                    <td class="text-end text-muted">@item.Price.ToString("#,##0 VND")</td>
                                                    <td class="text-end fw-semibold">@((item.Price * item.Quantity).ToString("#,##0 VND"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <div class="d-flex justify-content-end align-items-center mt-3 pt-2 border-top">
                                <span class="me-2 text-muted">Tổng cộng:</span>
                                <strong class="fs-5 text-danger">@order.Total.ToString("#,##0 VND")</strong>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div style="width: 80px; height: 80px; background: #f1f5f9; color: #94a3b8; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 36px;">
                        <i class="fa fa-shopping-basket"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Bạn chưa có đơn hàng nào</h5>
                    <p class="text-muted mb-4">Hãy khám phá các sản phẩm tuyệt vời của chúng tôi và đặt đơn hàng đầu tiên!</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                        <i class="fa fa-shopping-bag me-1"></i> Bắt đầu mua sắm
                    </a>
                </div>
            }
        </div>
    </div>
</div>
